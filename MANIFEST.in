include LICENSE README.md README.en.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md
include Dockerfile .dockerignore .editorconfig .gitattributes
include requirements-dev.txt
recursive-include riskcheck_data *.json
recursive-include docs *.md
recursive-include examples *.json *.yml
recursive-include schemas *.json
recursive-include tests *.py
recursive-include tools *.py
recursive-include .github *.yml *.md
global-exclude *.py[cod]
global-exclude .DS_Store
